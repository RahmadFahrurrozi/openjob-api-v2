{
  "name": "openjob-restful-api",
  "version": "1.0.0",
  "description": "OpenJob RESTful API V1 Submission",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "test": "node scripts/clean-db.js && newman run \"OpenJob RESTful API V1 Test/[271] OpenJob API Test V1.postman_collection.json\" -e \"OpenJob RESTful API V1 Test/OpenJob API.postman_environment.json\""
  },
  "keywords": [
    "express",
    "postgresql",
    "restful-api",
    "dicoding"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.2.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nanoid": "^3.3.8",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "^10.3.1",
    "nodemon": "^3.1.9",
    "pg": "^8.13.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "newman": "^6.2.2",
    "prettier": "^3.9.10"
  }
}
